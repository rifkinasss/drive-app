APP_NAME="Drive by NasLabs"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
API_DOCS_ENABLED=true
API_VERSION=2.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cloud
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
AUTH_REMEMBER_LIFETIME=43200

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
CLOUD_FILESYSTEM_ROOT=
CLOUD_STORAGE_DISK=cloud
CLOUD_STORAGE_ROOT=
CLOUD_MAX_UPLOAD_SIZE_BYTES=524288000
CLOUD_DEFAULT_USER_QUOTA_BYTES=26843545600
CACHE_STORE=database
USER_INVITATION_TTL_HOURS=72
EMAIL_VERIFICATION_TTL_HOURS=24

MAIL_MAILER=log
# SMTP is provider-agnostic. MAIL_SCHEME is used by Laravel 13; MAIL_ENCRYPTION is not.
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

VAPID_SUBJECT=mailto:hello@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
